# clang-tidy configuration for tests/ — Catch2-specific exclusions
# This file inherits the root .clang-tidy and adds test-specific suppressions.

InheritParentConfig: true

Checks:
  # --- Catch2 test framework exclusions ---
  # Anonymous namespace: Catch2 TEST_CASE design pattern
  - '-misc-use-anonymous-namespace'
  # Do-while: Catch2 REQUIRE/REQUIRE_THROWS macros expand to do-while loops
  - '-cppcoreguidelines-avoid-do-while'
  # Macro usage: Catch2 test framework macros (TEST_CASE, REQUIRE, CHECK, SECTION, etc.)
  - '-cppcoreguidelines-macro-usage'
  # Macro to enum: Catch2 configuration macros (CATCH_CONFIG_*)
  - '-cppcoreguidelines-macro-to-enum'
  - '-modernize-macro-to-enum'
  # Macro parentheses: Catch2 internal macro implementation details
  - '-bugprone-macro-parentheses'
  # Enum size: Catch2 internal enums
  - '-performance-enum-size'
  # Member init: Catch2 internal structs lack member initialization
  - '-cppcoreguidelines-pro-type-member-init'
  - '-hicpp-member-init'
  # Nodiscard: Catch2 functions lack [[nodiscard]] annotations
  - '-modernize-use-nodiscard'
  # Use after move: Catch2 REQUIRE_NOTHROW after move testing is intentional
  - '-bugprone-use-after-move'
  - '-clang-analyzer-cplusplus.Move'
  - '-hicpp-invalid-access-moved'
  # Capturing lambda coroutines: intentional in named variables (see AGENTS.md)
  - '-cppcoreguidelines-avoid-capturing-lambda-coroutines'
  # Reference coroutine parameters: tests intentionally pass references for brevity
  - '-cppcoreguidelines-avoid-reference-coroutine-parameters'
  # Inefficient vector operations: test setup code prioritizes clarity over performance
  - '-performance-inefficient-vector-operation'
  # Namespace using-directives: common pattern in test files for brevity
  - '-google-build-using-namespace'
  # Unnecessary copy initialization: test code may intentionally copy for verification
  - '-performance-unnecessary-copy-initialization'
  # Recursion: intentional in recursive test functions
  - '-misc-no-recursion'
  # Make member function const: test struct methods are not always const
  - '-readability-make-member-function-const'
  # --- tobus-specific test exclusions ---
  # Unused variable: test structs define unused metadata fields
  - '-clang-diagnostic-unused-const-variable'
  # Container size empty: test code may use direct comparison for readability
  - '-readability-container-size-empty'
  # Uppercase literal suffix: test code may use lowercase 'f' suffix for consistency
  - '-hicpp-uppercase-literal-suffix'
  - '-readability-uppercase-literal-suffix'
  # std::numbers: test constants intentionally use literals for clarity
  - '-modernize-use-std-numbers'
  # Exception baseclass: test code intentionally throws non-std-exception types (e.g., int)
  - '-hicpp-exception-baseclass'
  # Enum cast out of range: test code deliberately casts invalid values to test error handling
  - '-clang-analyzer-optin.core.EnumCastOutOfRange'
